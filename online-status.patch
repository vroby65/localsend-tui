+    pub(super) fn mark_not_reachable(&self, channel: &DeviceChannel) {
+        let mut devices = self.devices.lock().unwrap();
+        for device in devices.iter_mut() {
+            if let Some(status) = device.channels.get_mut(channel) {
+                *status = ChannelStatus::NotReachable;
+            }
+        }
+    }
