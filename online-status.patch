+/// Re-checks known devices so the device list reflects when they go offline.
+fn spawn_device_monitor(discovery: Arc<DiscoveryHandle>, events_tx: mpsc::Sender<AppEvent>) {
+    tokio::spawn(async move {
+        let mut interval = tokio::time::interval(Duration::from_secs(5));
+        let mut previous = std::collections::HashMap::<String, bool>::new();
+        interval.tick().await;
+        loop {
+            interval.tick().await;
+            let channels: Vec<HttpChannel> = discovery
+                .devices()
+                .into_iter()
+                .flat_map(|device| device.channels.into_keys())
+                .filter_map(|channel| channel.http().cloned())
+                .collect();
+            if !channels.is_empty() {
+                let _ = discovery.discover_known_http_channels(channels).await;
+            }
+            for device in discovery.devices() {
+                let online = device
+                    .channels
+                    .values()
+                    .any(|status| *status == ChannelStatus::Available);
+                if let Some(was_online) = previous.insert(device.device.fingerprint, online)
+                    && was_online != online
+                {
+                    let state = if online { "online" } else { "offline" };
+                    let _ = events_tx
+                        .send(AppEvent::Log {
+                            category: Category::Discovery,
+                            text: format!(
+                                "{} is {state}",
+                                crate::sanitize::single_line(&device.device.alias)
+                            ),
+                        })
+                        .await;
+                }
+            }
+        }
+    });
+}
+
+/// Finds devices that start LocalSend after this client has started, even on
+/// networks where multicast announcements do not reach this machine.
+fn spawn_subnet_scanner(discovery: Arc<DiscoveryHandle>, port: u16) {
+    let interface_ips = local_interface_addresses(&InterfaceFilter::default()).unwrap_or_default();
+    tokio::spawn(async move {
+        let mut interval = tokio::time::interval(Duration::from_secs(15));
+        interval.tick().await;
+        loop {
+            interval.tick().await;
+            for ip in &interface_ips {
+                let _ = discovery
+                    .scan_subnet(*ip, port, ProtocolType::Https)
+                    .await;
+            }
+        }
+    });
+}
